# =============================================================================
# IDaaS — environment template
# =============================================================================
# Plug-and-play quickstart (see docs/plans/2026-05-11-runtime-plug-and-play-design.md):
#
#   1. Generate every required secret in one shot:
#        cargo run -p api_server --bin api_server -- bootstrap --format env > .env.generated
#      Supported formats: env (dotenv), k8s (Secret manifest), json. The
#      command produces JWT ES256 (PKCS#8 PEM), Ed25519 compiler seed, all
#      symmetric encryption keys (FACTOR/LDAP/OAUTH_TOKEN/SSO), the OAuth DCR
#      initial-access token and a 24-char admin bootstrap password.
#
#   2. Verify the deployment is wired correctly:
#        cargo run -p api_server --bin api_server -- doctor
#      Read-only diagnostic that probes Postgres, Redis, the runtime gRPC
#      endpoint, secret presence and runtime-profile defaults. --format json
#      is suitable for CI gates.
#
#   3. Pick a runtime profile (auto-applies sane defaults for service DNS,
#      ports, log level, etc.):
#        IDAAS_RUNTIME_PROFILE=local       # default — localhost everything
#        IDAAS_RUNTIME_PROFILE=compose     # docker-compose service DNS (postgres/redis/runtime)
#        IDAAS_RUNTIME_PROFILE=kubernetes  # in-cluster service DNS + mounted-secret defaults
#        IDAAS_RUNTIME_PROFILE=production  # strict mode (refuses placeholders)
#
#   4. Choose where secrets come from (chained, first hit wins). Default:
#        IDAAS_SECRET_SOURCES=env,dotenv:./.env.generated,file:/var/run/secrets/idaas
#      Sources:
#        env                          — process environment (always available)
#        dotenv:<path>                — multi-line PEM-aware .env file
#        file:<dir>                   — Kubernetes Secret-as-volume layout
#                                        (one file per key, trailing \n stripped,
#                                        path traversal rejected)
#      Only the MANAGED_KEYS allowlist is preloaded (JWT/COMPILER/encryption
#      keys, DCR token, bootstrap password) — application-specific config
#      stays in the env block below.
#
# Lazy protocols (Phase 6): every external integration below is OPTIONAL.
# Leaving its credentials unset disables the feature with a clean HTTP 501
# (NOT_IMPLEMENTED) response — the service still boots and the rest of the
# product works. This applies to: Stripe billing, SendGrid/SES/SMTP email,
# SAML IdP, OAuth Dynamic Client Registration, LDAP, SCIM provisioning.
# =============================================================================

# Environment (set to "production" to enforce strict CORS, HTTPS cookies, etc.)
# APP_ENV=development
# ENVIRONMENT=development

# Runtime profile (see header). Picks defaults for service DNS, ports, log
# level. Explicit env vars below always override profile defaults.
# IDAAS_RUNTIME_PROFILE=local

# Secret source chain (see header). First source that returns a value wins.
# IDAAS_SECRET_SOURCES=env,dotenv:./.env.generated,file:/var/run/secrets/idaas

# Test seed bypass token. Required to call /api/test/* endpoints (which only
# exist in non-production builds). Sent by Playwright as `X-Test-Seed-Token`
# and matched constant-time in CSRF middleware. Leave unset in production —
# without it the bypass is disabled and CSRF rejects all /api/test/* calls.
TEST_SEED_TOKEN=dev-test-seed-token-change-for-staging

# Database
DATABASE_URL=postgres://idaas_user:password@localhost:5432/idaas
# ROOT_DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Database pool tuning (defaults are fine for dev)
# DB_MAX_CONNECTIONS=10
# DB_MIN_CONNECTIONS=1
# DB_ACQUIRE_TIMEOUT_SECS=30

# Read replicas (production only)
# ENABLE_READ_REPLICAS=false
# READ_REPLICA_URLS=postgres://reader:password@replica1:5432/idaas,postgres://reader:password@replica2:5432/idaas
# DB_MAX_CONNECTIONS_PER_REPLICA=5

# PgBouncer (production only)
# USE_PGBOUNCER=false
# PGBOUNCER_URL=postgres://idaas_user:password@localhost:6432/idaas

# Redis Configuration
# Mode: standalone, sentinel, or cluster
REDIS_MODE=standalone

# Standalone mode (default)
REDIS_URL=redis://localhost:6379

# Sentinel mode (high availability)
# Comma-separated list of sentinel addresses
# REDIS_SENTINEL_URLS=redis://localhost:26379,redis://localhost:26380,redis://localhost:26381
# REDIS_MASTER_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=
# REDIS_PASSWORD=

# Cluster mode (future)
# REDIS_CLUSTER_URLS=redis://node1:6379,redis://node2:6379,redis://node3:6379

# Connection settings
REDIS_MAX_CONNECTIONS=10
REDIS_MIN_IDLE=2
REDIS_CONNECTION_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
# REDIS_RESPONSE_TIMEOUT_MS=3000
# REDIS_DB=0
# REDIS_URLS=redis://node1:6379,redis://node2:6379

# Server
HOST=0.0.0.0
PORT=3000
RUST_LOG=info,api_server=debug

# Audit overflow queue
# Local default is fine for development. In production, point this to a
# persistent volume so overflowed audit records survive restarts.
AUDIT_OVERFLOW_PATH=./audit_overflow

# JWT Keys (ES256)
# Generate with: openssl ecparam -genkey -name prime256v1 -noout -out private.pem
# Extract public: openssl ec -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END EC PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----
JWT_EXPIRATION_SECONDS=60
JWT_ISSUER=https://auth.yourdomain.com
JWT_AUDIENCE=https://api.yourdomain.com

# Session cookie
SESSION_COOKIE_NAME=__session
SESSION_COOKIE_DOMAIN=localhost
SESSION_COOKIE_SECURE=false
SESSION_EXPIRATION_DAYS=30

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/oauth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/v1/oauth/github/callback

MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/v1/oauth/microsoft/callback

# OAuth Dynamic Client Registration (RFC 7591)
# If unset, POST /oauth/register is disabled with 403.
# OAUTH_DCR_INITIAL_ACCESS_TOKEN=

# Email Service (OPTIONAL — Phase 6 lazy protocol)
# With NO provider set, dev/staging logs the rendered email at WARN level
# and returns Ok; production (APP_ENV=production) fails loudly so callers
# can’t silently swallow undelivered OTPs. Configure SendGrid OR SMTP below.
#
# SendGrid (production)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=IDaaS Platform

# SMTP (development — use MailHog on localhost:1025)
# When SMTP_HOST is set it takes precedence over SendGrid.
# docker run -d -p 8025:8025 -p 1025:1025 mailhog/mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe (OPTIONAL — Phase 6 lazy protocol)
# Leave STRIPE_SECRET_KEY unset to disable billing entirely. Billing routes
# (/api/billing/checkout, /portal, /subscription/cancel, /webhook) then
# return HTTP 501 NOT_IMPLEMENTED instead of attempting Stripe calls.
# Read-only endpoints (GET /subscription, /invoices) gracefully return null/[].
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Frontend
FRONTEND_URL=http://localhost:5173

# Public backend/API base URL used in generated SAML IdP metadata and SSO URLs.
# PUBLIC_API_URL is preferred; API_PUBLIC_URL is accepted as a legacy alias.
# PUBLIC_API_URL=https://auth.yourdomain.com
# API_PUBLIC_URL=https://auth.yourdomain.com

# CORS (comma-separated origins, empty = allow all for dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# WebAuthn / Passkeys
# RP ID must match the domain where passkeys are registered.
# Origin must use HTTPS in production.
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000

# EIAA Capsule Compiler
# Base64-encoded Ed25519 secret key for capsule signing.
# Generate: openssl genpkey -algorithm ed25519 | openssl pkey -outform DER | base64
# WARNING: If not set, ephemeral keys are used — attestations won't survive restarts.
COMPILER_SK_B64=
RUNTIME_GRPC_ADDR=http://127.0.0.1:50061
# RUNTIME_GRPC_ENDPOINTS=http://127.0.0.1:50061,http://127.0.0.1:50062
# RUNTIME_LISTEN_ADDR=0.0.0.0:50061
# RUNTIME_DATABASE_URL=postgres://idaas_user:password@localhost:5432/idaas
# RUNTIME_COMPILER_PK_B64=

# EIAA risk score threshold (0-100). Requests at or above this score are denied.
EIAA_RISK_THRESHOLD=80

# EIAA nonce lifetime (seconds, default 300)
# NONCE_TTL_SECONDS=300

# IP Intelligence (optional, free tier)
IPLOCATE_API_KEY=
IPLOCATE_ENABLED=true
# IPLOCATE_API_URL=https://www.iplocate.io/api/lookup

# Have I Been Pwned — password breach checking (free, no key needed for basic use)
# HIBP_ENABLED=true

# Rate Limiting
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20

# File Storage (S3 compatible)
S3_BUCKET=idaas-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_ENDPOINT=https://s3.amazonaws.com

# Encryption key for sensitive data (32-byte hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# TOTP factor secret encryption (base64url-encoded 32-byte secret, no padding)
# If not set, TOTP secrets are stored in plaintext (insecure for production).
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
FACTOR_ENCRYPTION_KEY=

# LDAP bind-password encryption (base64url-encoded 32-byte secret, no padding)
# Prefer a dedicated LDAP key. If unset, LDAP encryption falls back to
# FACTOR_ENCRYPTION_KEY. Generate with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
LDAP_ENCRYPTION_KEY=

# Live LDAP integration test harness (ignored by default; requires a real LDAP/AD server)
# LDAP_TEST_HOST=dc01.corp.example.com
# LDAP_TEST_PORT=636
# LDAP_TEST_USE_SSL=true
# LDAP_TEST_START_TLS=false
# LDAP_TEST_SKIP_TLS_VERIFY=false
# LDAP_TEST_BIND_DN=CN=svc-idaas,OU=Service Accounts,DC=corp,DC=example,DC=com
# LDAP_TEST_BIND_PASSWORD=
# LDAP_TEST_BASE_DN=DC=corp,DC=example,DC=com
# LDAP_TEST_USER_FILTER=(&(objectClass=user)(mail=*))
# LDAP_TEST_PAGE_SIZE=500
# LDAP_TEST_EXPECT_MIN_ENTRIES=1
# LDAP_TEST_SEARCH_SCOPE=subtree
# LDAP_TEST_FAILOVER_HOSTS=

# OAuth token encryption (base64url-encoded 32-byte secret, no padding)
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
OAUTH_TOKEN_ENCRYPTION_KEY=

# SSO connection secrets encryption (base64url-encoded 32-byte secret, no padding)
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SSO_ENCRYPTION_KEY=

# OAuth2 client secret store backend.
# database: store SHA-256 hashes in Postgres (default)
# aws_kms: AWS KMS envelope-encryption backend (stub unless wired with real KMS calls)
# vault: HashiCorp Vault KV v2 backend
# SECRET_STORE_BACKEND=database
# AWS_KMS_KEY_ID=alias/idaas-oauth-client-secrets
# AWS_REGION=us-east-1
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=
# VAULT_KV_MOUNT=secret

# SAML Service Provider
SAML_CLOCK_SKEW_SECONDS=60
# SAML_ACS_URL=https://auth.yourdomain.com/v1/saml/acs
# SAML_SLO_URL=https://auth.yourdomain.com/api/auth/sso/saml/slo
# SAML_SP_ENTITY_ID=https://auth.yourdomain.com
# SAML_SP_SIGNING_KEY_PEM=
# SAML_SP_SIGNING_CERT_PEM=

# SAML Identity Provider (IDaaS as IdP)
# If SAML_IDP_SIGNING_* are unset, the IdP falls back to SAML_SP_SIGNING_*.
# SAML_IDP_ENTITY_ID=https://auth.yourdomain.com/api/saml/idp/{tenant_id}/metadata
# SAML_IDP_SSO_URL=https://auth.yourdomain.com/api/saml/idp/{tenant_id}/sso
# SAML_IDP_SIGNING_KEY_PEM=
# SAML_IDP_SIGNING_CERT_PEM=

# Bootstrap admin password (only used on first run to seed the system admin)
# Generate a strong password. If unset, no admin password is created.
# IDAAS_BOOTSTRAP_PASSWORD=

# Signup flow
# REQUIRE_EMAIL_VERIFICATION=true

# OpenTelemetry (production observability)
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=idaas-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_TRACES_SAMPLER_ARG=1.0
